<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>JobWorth — Know your real profit</title><meta name="description" content="Free job pricing and profit calculator for independent service pros."><style>:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#eaf4f2;background:#071b1d}*{box-sizing:border-box}body{margin:0}.wrap{max-width:980px;margin:auto;padding:24px}header{display:flex;align-items:center;justify-content:space-between;gap:12px}.brand{font-size:24px;font-weight:900;color:#74e4c1}.tag{font-size:12px;border:1px solid #385857;border-radius:999px;padding:6px 10px;color:#a6c4bd}h1{font-size:clamp(34px,6vw,58px);line-height:1.06;margin:58px 0 14px;letter-spacing:-1.5px}h1 span{color:#74e4c1}p{color:#acc6bf;line-height:1.55}.intro{max-width:640px;font-size:18px;margin-bottom:32px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{background:#103033;border:1px solid #2b5150;border-radius:18px;padding:24px}.card h2{margin:0 0 18px;font-size:20px}label{display:block;color:#c8dcd7;font-size:13px;margin:16px 0 7px}.field{position:relative}.field span{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#84aaa1}input{width:100%;padding:12px 12px 12px 29px;background:#071e21;border:1px solid #3c6260;border-radius:9px;color:#fff;font-size:17px}input:focus{outline:2px solid #75e3bd} .stat{padding:12px 0;border-bottom:1px solid #2b5150}.stat:last-child{border:0}.stat small{display:block;color:#a8c4bd;font-size:13px;margin-bottom:5px}.stat strong{font-size:30px}.mint{color:#74e4c1}.warning{color:#ffc17b}.tiny{font-size:12px}button{margin-top:20px;border:0;border-radius:10px;background:#74e4c1;color:#06231f;font-weight:800;padding:12px 18px;cursor:pointer}.footer{margin:35px 0 15px;font-size:12px;color:#a4bdb7} .result-note{padding:12px 14px;border-radius:10px;background:#092428;color:#b9d4cf;font-size:14px;margin-top:16px} @media(max-width:700px){.grid{grid-template-columns:1fr}h1{margin-top:32px}.wrap{padding:16px}.card{padding:20px}}</style></head><body><noscript><div style="padding:18px;background:#65391f;color:white;text-align:center;font-weight:bold">This file viewer has JavaScript disabled. Open JobWorth from a hosted website in Safari or Chrome to calculate results.</div></noscript><main class="wrap"><header><div class="brand">JobWorth<span style="color:#fff">.</span></div><div class="tag">FREE · NO SIGNUP</div></header><h1>Stop guessing.<br><span>Know what the job pays.</span></h1><p class="intro">A free profit and pricing calculator for anyone who quotes hands-on service jobs. Calculate your actual earnings after time, travel, and costs.</p><div class="grid"><section class="card"><h2>Your job details</h2><label for="quote">What will you charge the customer?</label><div class="field"><span>$</span><input id="quote" type="number" value="250" min="0" step="1"></div><label for="hours">Hours on site</label><div class="field"><span>◷</span><input id="hours" type="number" value="3" min="0" step=".25"></div><label for="extra">Extra hours (prep, admin, driving)</label><div class="field"><span>◷</span><input id="extra" type="number" value="1" min="0" step=".25"></div><label for="miles">Total round-trip miles</label><div class="field"><span>↔</span><input id="miles" type="number" value="35" min="0" step="1"></div><label for="milecost">Vehicle cost per mile (editable estimate)</label><div class="field"><span>$</span><input id="milecost" type="number" value="0.35" min="0" step=".01"></div><label for="supplies">Supplies and other job expenses</label><div class="field"><span>$</span><input id="supplies" type="number" value="35" min="0" step="1"></div><label for="rate">Target hourly earnings</label><div class="field"><span>$</span><input id="rate" type="number" value="50" min="0" step="1"></div></section><section class="card"><h2>The real numbers</h2><div class="stat"><small>Profit before taxes and fixed overhead</small><strong class="mint" id="profit">Waiting for calculator…</strong></div><div class="stat"><small>Effective earnings per hour</small><strong id="effective">—</strong></div><div class="stat"><small>Direct job costs</small><strong id="costs">—</strong></div><div class="stat"><small>Minimum price to hit your hourly target</small><strong id="minimum">—</strong></div><div class="stat"><small>Difference from your target price</small><strong id="difference">—</strong></div><div class="result-note" id="message" role="status">If results do not update, your file preview is blocking JavaScript. Open the calculator as a hosted HTTPS web page instead.</div><button id="copy">Copy job summary</button><p class="tiny">All calculations happen on your device. Nothing is uploaded.</p></section></div><p class="footer">JobWorth is a decision-support calculator, not tax or accounting advice. Profits exclude income taxes, insurance, fixed overhead, and other costs you have not entered. Never use results as a guaranteed quote.</p></main><script>const ids=['quote','hours','extra','miles','milecost','supplies','rate'];const e=Object.fromEntries(ids.map(k=>[k,document.getElementById(k)]));const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(n);let summary='';function calc(){const n=k=>Math.max(0,Number(e[k].value)||0);let q=n('quote'),h=n('hours')+n('extra'),c=n('miles')*n('milecost')+n('supplies'),p=q-c,eff=h>0?p/h:null,min=c+h*n('rate'),diff=q-min;document.getElementById('profit').textContent=money(p);document.getElementById('effective').textContent=eff===null?'—':money(eff);document.getElementById('costs').textContent=money(c);document.getElementById('minimum').textContent=money(min);document.getElementById('difference').textContent=(diff>=0?'+':'')+money(diff);document.getElementById('difference').className=diff>=0?'mint':'warning';document.getElementById('message').textContent=h===0?'Add your total work hours to calculate an hourly rate.':diff>=0?'This quote meets your target hourly earnings before taxes and overhead.':'At this price, you are '+money(-diff)+' below your target for the job.';summary=`JobWorth estimate\nQuote: ${money(q)}\nDirect costs: ${money(c)}\nTotal hours: ${h}\nProfit before taxes/overhead: ${money(p)}\nEffective hourly earnings: ${eff===null?'N/A':money(eff)}\nMinimum target quote: ${money(min)}`;}ids.forEach(k=>e[k].addEventListener('input',calc));document.getElementById('copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(summary);document.getElementById('copy').textContent='Copied!';setTimeout(()=>document.getElementById('copy').textContent='Copy job summary',1500)}catch{prompt('Copy this summary:',summary)}});calc();</script></body></html>
